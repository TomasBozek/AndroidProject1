<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Asked for from the Permissions screen, not on first launch. The channel it posts to is
         created in App.onCreate. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AndroidProject1">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="${appLabel}"
            android:theme="@style/Theme.AndroidProject1.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- `<scheme>://product/<id>`. The scheme is the app's own rather than a domain,
                 so it needs no assetlinks.json and no site to host one; a real product would
                 add an `android:autoVerify` https filter beside this, not instead of it.
                 BROWSABLE is what lets the link be followed from another app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="@string/deep_link_scheme" />
            </intent-filter>
        </activity>
    </application>

</manifest>